# Copy to .env and fill in.

# Hermes Agent is the default AI provider. Its bearer key stays server-side.
AI_PROVIDER=hermes
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=mlx-community/gemma-4-26B-A4B-it-OptiQ-4bit
HERMES_TIMEOUT_SECONDS=300

# OCR label correction talks to Ollama directly. No API key is required.
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_OCR_MODEL=gemma4:12b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_OCR_NUM_CTX=4096
ENABLE_AUTOMATIC_OCR_LABEL_REVIEW=true
AUTOMATIC_OCR_LABEL_LIMIT=150

# Optional fallback only. Sync normally detects active Wi-Fi/Ethernet itself.
SYNC_ADVERTISED_HOST=

# Optional Quick Correct library. The Core reads and writes only this folder
# inside the Obsidian vault.
OBSIDIAN_VAULT_PATH=/Users/dien/Obsidian
OBSIDIAN_LABEL_LIBRARY_PATH=Financial Analyze/Label Library
OBSIDIAN_LINE_CATALOG_PATH=Financial Analyze/Line Catalog

# Cloud AI is an explicit opt-in fallback.
ENABLE_CLOUD_AI=false
ANTHROPIC_API_KEY=

# Unsafe prototype escape hatch. Keep false until reconciliation is implemented.
ALLOW_UNVERIFIED_FILING_AI=false

# Database — local SQLite. Relative paths are resolved against backend/,
# not the directory uvicorn is started from. Default: backend/helix.db
DATABASE_URL=sqlite:///./helix.db

# Redis — leave blank to disable caching (nothing needs it locally)
REDIS_URL=

# Screener background refresh (prices after close, financials weekly).
ENABLE_SCREENER_REFRESH=true
# vnstock (live VCI data) | fixture (built-in sample; refresh thread stays off)
SCREENER_PROVIDER=vnstock

# Browser origins allowed to call the API (comma-separated). Requests with any
# other Origin header are rejected with 403; "*" is NOT accepted (there is no
# auth, so any web page could otherwise drive the API). scripts/run.sh sets
# this from FRONTEND_PORT/BACKEND_PORT. Add "null" only if you open the
# frontend from file://.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# File storage (relative paths are resolved against backend/)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Gmail SSI report import (app password lives in the macOS Keychain)
GMAIL_DOWNLOAD_DIR=./data/gmail_reports
ENABLE_GMAIL_POLLER=true

# News: self-hosted SearXNG and the Obsidian folder for daily news notes
SEARXNG_URL=http://127.0.0.1:8888
VAULT_NEWS_DIR=/Users/dien/Obsidian/Projects/Financial_Automation/News
